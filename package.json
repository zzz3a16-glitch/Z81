{
  "name": "zpopcorn",
  "productName": "zPopcorn",
  "version": "2.1.0",
  "description": "zPopcorn — Premium Local-First Media Library & Intelligent Personal Media Platform for Windows (Electron)",
  "author": "zPopcorn Project",
  "license": "MIT",
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dev:desktop": "cross-env NODE_ENV=development electron .",
    "test": "node --test tests/backend.test.mjs",
    "rebuild": "npx --yes @electron/rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "audit:tokens": "python3 scripts/audit-tokens.py"
  },
  "dependencies": {
    "@lordicon/element": "^2.3.1",
    "better-sqlite3": "^11.10.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.4",
    "@phosphor-icons/core": "^2.1.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
